# OpenAI API (분류기)
OPENAI_API_KEY=sk-...

# Anthropic API (전략 인사이트 요약)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase PostgreSQL
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=...
DB_NAME=postgres

# Naver News Search API — 한국 실시간 뉴스 (https://developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Reddit — API 키 불필요 (RSS 방식으로 수집)

# Slack Webhook — HIGH 기사 알림 (선택)
SLACK_WEBHOOK_URL=

# 올리브영 채널 MCP (원격) — 국내 랭킹·리뷰·자사 성과 수집
# 비어 있으면 Authorization 헤더가 붙지 않아 401 이 난다.
# MCP_API_KEY(자체 in-proc MCP)와 다른 변수다.
CHANNEL_MCP_API_KEY=
